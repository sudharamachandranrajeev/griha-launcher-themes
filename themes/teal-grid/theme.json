{
  "id": "teal-grid",
  "name": "Teal Grid",
  "version": 2,
  "engine": 2,
  "author": "sudharamachandranrajeev",
  "description": "A product styleguide in teal and cream: headline time, chips, underline tabs, a status card and alert banners on a fine column grid.",
  "inspiration": "The product UI styleguide board: headlines, chips, tabs, cards and alerts, set in teal.",
  "requires": [
    "backdrop.grid",
    "depth.inner",
    "depth.shadows",
    "font.system",
    "headings.style",
    "home.blocks",
    "palette.v1",
    "touch.glow"
  ],
  "prefers": [
    "icons.badge",
    "lock.subject",
    "lock.theme",
    "wall.motion",
    "widget.well"
  ],
  "palette": {
    "light": {
      "background": "#13615F",
      "surface": "#0E5654",
      "accent": "#F3EDE2",
      "secondary": "#0C4644",
      "ink": "#F3EDE2",
      "muted": "#A9CFC9",
      "onSurface": "#F3EDE2",
      "extras": {
        "paper": "#F3EDE2",
        "gold": "#E3B25B"
      }
    },
    "dark": {
      "background": "#0D4846",
      "surface": "#0A403E",
      "accent": "#E8E1D4",
      "secondary": "#082F2E",
      "ink": "#EDE6DA",
      "muted": "#94BDB7",
      "onSurface": "#EDE6DA",
      "extras": {
        "paper": "#E8E1D4",
        "gold": "#D9A54A"
      }
    }
  },
  "depth": {
    "corners": 0.6,
    "card": {
      "fill": [
        "#136664",
        "#0C4E4C"
      ],
      "shadows": [
        [
          0,
          8,
          18,
          "#031F1E@0.55"
        ]
      ],
      "rim": {
        "width": 1,
        "top": "white@0.14",
        "bottom": "black@0.3"
      }
    },
    "key": {
      "fill": [
        "#15706D",
        "#0D5250"
      ],
      "rim": {
        "width": 1.5,
        "top": "white@0.2",
        "bottom": "black@0.35"
      },
      "shadows": [
        [
          0,
          4,
          8,
          "#031F1E@0.6"
        ]
      ],
      "pressInner": [
        [
          0,
          3,
          6,
          "#031F1E@0.6"
        ]
      ]
    },
    "field": {
      "fill": [
        "#0F5452",
        "#17716E"
      ],
      "inner": [
        [
          0,
          14,
          28,
          "#031F1E@0.7"
        ],
        [
          0,
          -6,
          14,
          "#7FCFC6@0.45"
        ]
      ]
    },
    "primary": {
      "fill": [
        "#E3B25B"
      ],
      "shadows": [
        [
          0,
          6,
          14,
          "#062B2A@0.5"
        ]
      ],
      "rim": {
        "width": 1,
        "top": "white@0.4",
        "bottom": "black@0.2"
      }
    }
  },
  "headings": {
    "caps": true,
    "spacing": 0.06,
    "font": "system:sans-serif-condensed"
  },
  "backdrop": {
    "kind": "grid"
  },
  "touch": {
    "pulse": "glow"
  },
  "icons": {
    "style": "badge",
    "badge": "#F3EDE2",
    "glyph": "background"
  },
  "widgets": {
    "clock": {
      "style": "well",
      "numerals": "mixed",
      "size": 0.78
    }
  },
  "fonts": {
    "display": "system:sans-serif-thin"
  },
  "wallpapers": [
    {
      "file": "wallpapers/home.jpg",
      "for": "any",
      "dim": 0
    }
  ],
  "preview": "preview.png",
  "home": [
    {
      "type": "headline",
      "gap": 4
    },
    {
      "type": "chips"
    },
    {
      "type": "tabs",
      "style": "underline",
      "gap": 18
    },
    {
      "type": "status"
    },
    {
      "type": "alerts"
    },
    {
      "type": "apps",
      "style": "tiles",
      "columns": 4,
      "count": 8
    }
  ],
  "lock": {
    "subject": "rim",
    "amount": 0.4,
    "tint": "#E3B25B",
    "text": "#E3B25B",
    "font": "serif"
  }
}
