{
  "id": "tangerine-peel",
  "name": "Tangerine Peel",
  "version": 5,
  "engine": 2,
  "author": "sudharamachandranrajeev",
  "description": "Orange paper under a cream panel peeling back to show black, cream cards, a deep clock well and black badge icons.",
  "inspiration": "An orange home with a curled page corner, an inset analog clock and round black icons.",
  "requires": [
    "decor.peel",
    "depth.inner",
    "depth.shadows",
    "font.system",
    "headings.style",
    "home.blocks",
    "icons.badge",
    "palette.v1",
    "touch.glow",
    "widget.well"
  ],
  "prefers": [
    "font.bundled",
    "lock.subject",
    "lock.theme",
    "wall.motion"
  ],
  "palette": {
    "light": {
      "background": "#F28C45",
      "surface": "#F7F4EF",
      "accent": "#161616",
      "secondary": "#C5642A",
      "ink": "#121212",
      "muted": "#5B3417",
      "onSurface": "#121212",
      "extras": {
        "paper": "#F7F4EF",
        "numeral": "#121212"
      }
    },
    "dark": {
      "background": "#D9722D",
      "surface": "#E8E3DC",
      "accent": "#111111",
      "secondary": "#A85020",
      "ink": "#0E0E0E",
      "muted": "#4A2A12",
      "onSurface": "#0E0E0E",
      "extras": {
        "paper": "#E8E3DC",
        "numeral": "#0E0E0E"
      }
    }
  },
  "depth": {
    "corners": 0.9,
    "card": {
      "fill": [
        "#FBF9F5",
        "#EFEAE2"
      ],
      "shadows": [
        [
          0,
          8,
          18,
          "#7A3A10@0.45"
        ]
      ],
      "rim": {
        "width": 1,
        "top": "white",
        "bottom": "black@0.08"
      }
    },
    "key": {
      "fill": [
        "#FBF9F5",
        "#E9E3D9"
      ],
      "rim": {
        "width": 1.5,
        "top": "white",
        "bottom": "black@0.12"
      },
      "shadows": [
        [
          0,
          4,
          8,
          "#7A3A10@0.6"
        ]
      ],
      "pressInner": [
        [
          0,
          3,
          6,
          "#7A3A10@0.4"
        ]
      ]
    },
    "field": {
      "fill": [
        "#E5793A",
        "#F49656"
      ],
      "inner": [
        [
          0,
          14,
          28,
          "#6E2F08@0.65"
        ],
        [
          0,
          -6,
          14,
          "#FFD2AE@0.55"
        ]
      ]
    },
    "primary": {
      "fill": [
        "#2A2A2A",
        "#121212"
      ],
      "rim": {
        "width": 1,
        "top": "white@0.2",
        "bottom": "black@0.5"
      },
      "gloss": 0.18,
      "shadows": [
        [
          0,
          6,
          14,
          "#7A3A10@0.5"
        ]
      ]
    }
  },
  "headings": {
    "caps": true,
    "spacing": 0.04,
    "font": "system:sans-serif-condensed"
  },
  "backdrop": {
    "kind": "peel"
  },
  "decor": {
    "peel": {
      "corner": "top-right",
      "panel": "#F7F4EF",
      "paper": "#1A1A1A",
      "band": 0.385
    }
  },
  "touch": {
    "pulse": "glow"
  },
  "icons": {
    "style": "badge",
    "badge": "#121212",
    "glyph": "background"
  },
  "widgets": {
    "clock": {
      "style": "well",
      "numerals": "mixed",
      "size": 0.78
    }
  },
  "fonts": {
    "display": "system:sans-serif-thin",
    "script": "bundled:dancing_script"
  },
  "wallpapers": [
    {
      "file": "wallpapers/home.jpg",
      "for": "any",
      "dim": 0
    }
  ],
  "preview": "preview.png",
  "home": [
    {
      "type": "panel",
      "gap": 6
    },
    {
      "type": "well",
      "gap": 96
    },
    {
      "type": "dock",
      "style": "badges",
      "count": 6,
      "gap": 34
    }
  ],
  "lock": {
    "subject": "rim",
    "amount": 0.45,
    "tint": "secondary",
    "text": "secondary",
    "font": "condensed"
  }
}
