{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sudharamachandranrajeev/griha-themes/schema/theme.schema.json",
  "title": "Griha theme",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "engine",
    "requires",
    "palette",
    "depth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "maxLength": 40
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "engine": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "inspiration": {
      "type": "string"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "prefers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "palette": {
      "type": "object",
      "required": [
        "light",
        "dark"
      ],
      "properties": {
        "light": {
          "$ref": "#/$defs/colours"
        },
        "dark": {
          "$ref": "#/$defs/colours"
        }
      }
    },
    "depth": {
      "type": "object",
      "properties": {
        "corners": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "outline": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "colour": {
              "$ref": "#/$defs/colour"
            },
            "roles": {
              "type": "array"
            }
          }
        },
        "card": {
          "$ref": "#/$defs/surface"
        },
        "key": {
          "$ref": "#/$defs/surface"
        },
        "field": {
          "$ref": "#/$defs/surface"
        },
        "primary": {
          "$ref": "#/$defs/surface"
        }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/colour"
      }
    },
    "headings": {
      "type": "object",
      "properties": {
        "caps": {
          "type": "boolean"
        },
        "spacing": {
          "type": "number"
        },
        "font": {
          "type": "string"
        }
      }
    },
    "backdrop": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      }
    },
    "touch": {
      "type": "object",
      "properties": {
        "pulse": {
          "enum": [
            "bloom",
            "ring",
            "glow",
            "ripple",
            "embers",
            "none"
          ]
        }
      }
    },
    "icons": {
      "type": "object"
    },
    "widgets": {
      "type": "object"
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "wallpapers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "for"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^wallpapers/[a-z0-9-]+\\.(jpg|png|webp)$"
          },
          "for": {
            "enum": [
              "home",
              "drawer",
              "lock",
              "any"
            ]
          },
          "dim": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "preview": {
      "type": "string"
    },
    "home": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "row",
              "stack",
              "spacer",
              "clockCard",
              "week",
              "meters",
              "apps",
              "rings",
              "motto",
              "panel",
              "well",
              "dock",
              "tabs",
              "stats",
              "toasts",
              "profile",
              "note",
              "nav",
              "headline",
              "chips",
              "alerts",
              "status",
              "battery",
              "search",
              "label",
              "infoKeys"
            ]
          }
        }
      }
    },
    "decor": {
      "type": "object"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the theme dresses the lock screen (lock.theme, lock.subject; Griha 0.7.0+, older Griha ignores it).",
      "properties": {
        "subject": {
          "enum": [
            "wash",
            "duotone",
            "rim",
            "halo"
          ],
          "description": "The theme's pick for styling the lock photo's subject; users can change or turn it off."
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly; keep it subtle (0.25 to 0.5)."
        },
        "tint": {
          "type": "string",
          "description": "Colour token the subject is styled in; the accent by default."
        },
        "text": {
          "type": "string",
          "description": "Colour token for the lock date; the accent by default. Griha shades it until it reads on the photo."
        },
        "font": {
          "enum": [
            "thin",
            "heavy",
            "bold",
            "condensed",
            "serif",
            "script"
          ]
        },
        "clock": {
          "description": "The clock piece for the lock screen (lock.clock, Griha 0.8.0+): a home block or a list of them, drawn in its date edition. Without it, the first clock on the theme's home is used.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "clockCard",
                    "well",
                    "rings",
                    "headline",
                    "panel",
                    "stats",
                    "infoKeys",
                    "week"
                  ]
                }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "clockCard",
                      "well",
                      "rings",
                      "headline",
                      "panel",
                      "stats",
                      "infoKeys",
                      "week"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "colour": {
      "type": "string",
      "pattern": "^((#[0-9A-Fa-f]{6}|background|surface|accent|secondary|ink|muted|onSurface|white|black)(@(0|1|0?\\.[0-9]+))?|#[0-9A-Fa-f]{8})$",
      "description": "#RRGGBB, #AARRGGBB, or a palette name; any but #AARRGGBB may add @opacity, such as accent@0.4."
    },
    "colours": {
      "type": "object",
      "required": [
        "background",
        "surface",
        "accent",
        "secondary",
        "ink",
        "muted"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/colour"
        },
        "surface": {
          "$ref": "#/$defs/colour"
        },
        "accent": {
          "$ref": "#/$defs/colour"
        },
        "secondary": {
          "$ref": "#/$defs/colour"
        },
        "ink": {
          "$ref": "#/$defs/colour"
        },
        "muted": {
          "$ref": "#/$defs/colour"
        },
        "onSurface": {
          "$ref": "#/$defs/colour"
        },
        "extras": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/colour"
          }
        }
      }
    },
    "shade": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/colour"
        }
      ],
      "minItems": 4,
      "maxItems": 5
    },
    "surface": {
      "type": "object",
      "properties": {
        "fill": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/colour"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "rim": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "top": {
              "$ref": "#/$defs/colour"
            },
            "bottom": {
              "$ref": "#/$defs/colour"
            }
          }
        },
        "shadows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shade"
          }
        },
        "inner": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shade"
          }
        },
        "pressInner": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shade"
          }
        },
        "glow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shade"
          }
        },
        "lip": {
          "type": "number"
        },
        "gloss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
